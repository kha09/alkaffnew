// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  description String
  image       String
  gradient    String
  order       Int      @default(0)
}

model University {
  id             Int    @id @default(autoincrement())
  name           String
  country        String
  logo           String
  ranking        String
  students       String
  programs       String
  acceptance     String
  color          String
  flag           String
  order          Int    @default(0)
  freeOfferLetter Boolean @default(false)
  departments    Department[]
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  university University @relation(fields: [universityId], references: [id])
  universityId Int
  programs   Program[]
}

model Program {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  tuitionFees       String
  duration          String
  intakeMonths      String
  qualification     String   @default("Bachelor's Degree")
  englishRequirement String   @default("IELTS 5.5")
  offerLetter       Boolean  @default(true)
  classType         String   @default("Physical")
  // Detailed fee structure for international students
  yearlyTuitionFees String   @default("") // JSON string for yearly fees
  otherFees         String   @default("") // JSON string for other fees
  department        Department @relation(fields: [departmentId], references: [id])
  departmentId      Int
}

model Testimonial {
  id         Int    @id @default(autoincrement())
  name       String
  program    String
  text       String
  rating     Int
  avatar     String
  university String
  country    String
  flag       String
  date       String
  hasVideo   Boolean
  featured   Boolean
  category   String
  order      Int    @default(0)
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String
  popular  Boolean
  order    Int    @default(0)
}

model WhySMAlkaff {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  features    String   // JSON string for features array
}

model HowItWorks {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  steps       String   // JSON string for steps array
}

model FormSubmission {
  id                Int           @id @default(autoincrement())
  fullName          String
  nationality       String
  email             String
  countryOfResidence String
  contactNumber     String
  cityOfResidence   String
  preferredProgram  String
  universityId      Int?
  programId         Int?
  submittedAt       DateTime      @default(now())
  uploadedFiles     UploadedFile[]
  agentId           Int?          // For agent assignment
  agent             Agent?        @relation(fields: [agentId], references: [id])
  orderStage        String        @default("New") // For order stage management
  userId            Int?          @unique // For user account linking (one-to-one)
  user              User?         @relation(fields: [userId], references: [id])
  orders            Order[]
}

model Agent {
  id         Int            @id @default(autoincrement())
  name       String
  email      String         @unique
  phone      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  submissions FormSubmission[]
  orders     Order[]
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String         // Hashed password
  email         String         @unique
  fullName      String
  formSubmissionId Int?        @unique // Link to form submission (one-to-one)
  formSubmission FormSubmission?
  orders        Order[]
  role          String         @default("student") // "student", "agent", or "admin"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UploadedFile {
  id              Int      @id @default(autoincrement())
  filename        String
  originalName    String
  path            String
  size            Int
  type            String
  formSubmission  FormSubmission @relation(fields: [formSubmissionId], references: [id])
  formSubmissionId Int
  uploadedAt      DateTime @default(now())
}

model Order {
  id              Int        @id @default(autoincrement())
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  formSubmissionId Int?
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id])
  agentId         Int?
  agent           Agent?     @relation(fields: [agentId], references: [id])
  price           Float
  status          String     @default("pending") // pending, completed, cancelled
  paymentStatus   String     @default("unpaid")  // paid, unpaid, refunded
  dateCreated     DateTime   @default(now())
  receipt         String?    // URL or path to receipt file
  notes           String?    // Additional notes about the order
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Commission {
  id              Int        @id @default(autoincrement())
  agentId         Int
  agent           Agent      @relation(fields: [agentId], references: [id])
  orderId         Int
  order           Order      @relation(fields: [orderId], references: [id])
  amount          Float      // Commission amount
  status          String     @default("pending") // pending, approved, paid, rejected
  requestedAt     DateTime   @default(now())
  approvedAt      DateTime?  // When admin approves
  paidAt          DateTime?  // When commission is paid
  notes           String?    // Admin notes
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
