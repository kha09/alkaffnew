// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  description String
  image       String
  gradient    String
  order       Int      @default(0)
}

model University {
  id             Int    @id @default(autoincrement())
  name           String
  country        String
  logo           String
  ranking        String
  students       String
  programs       String
  acceptance     String
  color          String
  flag           String
  order          Int    @default(0)
  freeOfferLetter Boolean @default(false)
  departments    Department[]
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  university University @relation(fields: [universityId], references: [id])
  universityId Int
  programs   Program[]
}

model Program {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  tuitionFees       String
  duration          String
  intakeMonths      String
  qualification     String   @default("Bachelor's Degree")
  englishRequirement String   @default("IELTS 5.5")
  offerLetter       Boolean  @default(true)
  classType         String   @default("Physical")
  // Detailed fee structure for international students
  yearlyTuitionFees String   @default("") // JSON string for yearly fees
  otherFees         String   @default("") // JSON string for other fees
  department        Department @relation(fields: [departmentId], references: [id])
  departmentId      Int
}

model Testimonial {
  id         Int    @id @default(autoincrement())
  name       String
  program    String
  text       String
  rating     Int
  avatar     String
  university String
  country    String
  flag       String
  date       String
  hasVideo   Boolean
  featured   Boolean
  category   String
  order      Int    @default(0)
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String
  popular  Boolean
  order    Int    @default(0)
}
